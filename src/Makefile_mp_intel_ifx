# 
# PURPOSE:  MAKEFILE FOR GNU/Linux SPIDER using FFTW3 on multiple processors. 
#
# USING:    Intel ifx Fortran compiler
# TARGET:   Same machine as compiled on  
# IMAGES:   Optimal SPIDER image byte order: native to machine 
#
# FOR INITIAL USE: 
#           Since .mod files are not compatible with those from other compilers
#           Put any existing *.mod files in a separate dir to avoid clashes
#           e.g.:  mkdir gfort_mods; mv *.mod  gfort_mods
#           BE SURE AND COMPILE IN A CLEAN DIRECTORY!!!

# STATIC:   For static libs use: zypper install glibc-static.x86_64  DONE

# NOTE:     Uses FFTW3 configured with: --enable-float --enable-openmp

# USAGE:    source  /home/dean/Software/Intel/oneapi/setvars.sh
#           make -f Makefile_mp_intel_ifx_g


# TESTING:  cd /home/dean/Software/test-not-complete-0-dup ; 
#           /home/dean/Software/spider-2026/src/spider_mp_intel_ifx  tst/tst @testops

# SOME INTEL IFX COMPILE/LINK FLAGS
#           -qopenmp            : Invokes multi processor support 
#           -assume byterecl 
#           -parallel  !! NOT SUPPORTED
#           -O2 
#           -WB 
#           -fpp  
#           -zero 
#           -static 
#           -fixed 
#           -g -O0              : For debugger 
#           -convert big_endian ! NOPE
#           -module  ifx_mods Use -I flag followed by the directory path 
#                     (e.g., ifx -I/path/to/modules program.f).

AFLAGS   = r

SHELL    = /bin/sh

# Location of Intel ifx Fortran compiler: 
COMP     =  /home/dean/Software/Intel/oneapi/compiler/2025.3/bin/ifx

# Location for new Intel ifx Fortran executable: 
EXE      = spider_mp_intel_ifx

# Location for new Intel ifx objects: 
LIB      = $(EXE).a

FFLAGS   = -assume byterecl -qopenmp  -WB -fpp -zero -fixed -static -DSP_MP -DSP_LIBFFTW3 -DSP_IFX  -O2 -c

LF       = -static  -qopenmp  

# Link with FFTW3 static libraries with threads and with math library  !! GFORT
FFTWLIBDIR = ../fftw/fftw3310-intel-gfort/lib

# Link with FFTW3 static libraries with threads and with math library
LINKLIBS = -static -L$(FFTWLIBDIR) -lfftw3f_threads -lfftw3f -lfftw3f_omp -lm   

.PRECIOUS :  ../bin/$(EXE) $(LIB) 

include Makefile.inc

$(EXE) : $(LIB)
	$(COMP) $(LF)  $(LIB) $(LINKLIBS) -o $(EXE) 
	@echo "Created: $(EXE)"
	@echo " "

$(LIB) : $(ELEMENTS)
	@echo "        linking $(EXE) now ----"
.f.a:
	$(COMP) $(FFLAGS) $<
	$(AR) $(AFLAGS) $(LIB) $*.o
	@\rm $*.o




